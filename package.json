{
  "name": "webhealth-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --filter @webhealth/web dev",
    "build": "pnpm --filter @webhealth/web build",
    "start": "pnpm --filter @webhealth/web start",
    "worker": "pnpm --filter @webhealth/worker start",
    "worker:once": "pnpm --filter @webhealth/worker start:once",
    "db:push": "pnpm --filter @webhealth/shared db:push",
    "db:seed:plan-settings": "pnpm --filter @webhealth/shared db:seed:plan-settings",
    "stripe:listen": "stripe listen --forward-to ${NEXT_PUBLIC_APP_URL:-https://webhealth.devbrew.dev}/api/stripe/webhook"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.10",
      "express-rate-limit": "8.2.2",
      "hono": "4.12.7",
      "minimatch@10.2.2": "10.2.4",
      "minimatch@3.1.3": "3.1.4",
      "minimatch@9.0.6": "9.0.7"
    }
  }
}

{
  "name": "webhealth-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --filter @webhealth/web dev",
    "build": "pnpm --filter @webhealth/web build",
    "start": "pnpm --filter @webhealth/web start",
    "worker": "pnpm --filter @webhealth/worker start",
    "worker:once": "pnpm --filter @webhealth/worker start:once",
    "db:push": "pnpm --filter @webhealth/web db:push",
    "db:migrate": "pnpm --filter @webhealth/web db:migrate",
    "db:seed:plan-settings": "pnpm --filter @webhealth/web db:seed:plan-settings",
    "openai:reconcile-costs": "pnpm --filter @webhealth/worker openai:reconcile-costs"
  }
}

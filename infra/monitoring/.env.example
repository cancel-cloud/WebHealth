PROMETHEUS_BASE_IMAGE=prom/prometheus:latest
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_POSTGRES_EXPORTER_TARGET=<db-stack-postgres-exporter-service-name>:9187
PROMETHEUS_NODE_EXPORTER_TARGET=<db-stack-node-exporter-service-name>:9100

GRAFANA_IMAGE=grafana/grafana-oss:latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-secret

POSTGRES_BASE_IMAGE=postgres:18.3-bookworm
POSTGRES_DB=webhealth
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-long-random-secret
POSTGRES_RUNTIME_USER=webhealth_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-long-random-secret
POSTGRES_DIRECT_USER=webhealth_direct
POSTGRES_DIRECT_PASSWORD=replace-with-long-random-secret
POSTGRES_REPLICATION_USER=webhealth_replication
POSTGRES_REPLICATION_PASSWORD=replace-with-long-random-secret
POSTGRES_MONITORING_USER=webhealth_monitoring
POSTGRES_MONITORING_PASSWORD=replace-with-long-random-secret

PGBOUNCER_BASE_IMAGE=debian:bookworm-slim
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_SERVER_IDLE_TIMEOUT=60
PGBOUNCER_LISTEN_PORT=6432
PGBOUNCER_ADMIN_USERS=postgres,webhealth_direct
PGBOUNCER_STATS_USERS=webhealth_direct,webhealth_monitoring
PGBOUNCER_TLS_CERT_FILE=/etc/pgbouncer/certs/server.crt
PGBOUNCER_TLS_KEY_FILE=/etc/pgbouncer/certs/server.key

PGBACKREST_STANZA=webhealth
PGBACKREST_FULL_INTERVAL_SECONDS=86400
PGBACKREST_DIFF_INTERVAL_SECONDS=21600
PGBACKREST_LOOP_SLEEP_SECONDS=300
PGBACKREST_REPO_RETENTION_FULL=7
PGBACKREST_REPO_RETENTION_DIFF=28

POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:latest
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:latest
PGADMIN_IMAGE=dpage/pgadmin4:latest
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-long-random-secret
# Generate a self-signed cert for transport encryption:
# openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
#   -keyout db-tls.key -out db-tls.crt \
#   -subj "/CN=db.webhealth.devbrew.dev" \
#   -addext "subjectAltName=DNS:db.webhealth.devbrew.dev,IP:178.104.11.44"
DB_TLS_CERT_PEM=-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----
DB_TLS_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----

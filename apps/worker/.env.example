# apps/worker runtime env

# Shared runtime/db
DATABASE_URL=postgresql://<runtime-user>:<password>@db.webhealth.devbrew.dev:6432/webhealth?sslmode=require
DIRECT_DATABASE_URL=postgresql://<direct-user>:<password>@<private-host-or-predefined-network-name>:5432/webhealth?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT=20
DATABASE_POOL_CONNECT_TIMEOUT=10
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
ARTIFACT_TOKEN_SECRET=replace-with-long-random-secret

# Shared auth/google credentials used for token refresh + API access
BETTER_AUTH_URL=https://webaudit-25.localcan.dev
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Monitoring
SENTRY_DSN=https://public@example-glitchtip.dev/1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG=org_replace_with_org_id
OPENAI_PROJECT=proj_replace_with_project_id
OPENAI_MAX_TOKENS=1200
OPENAI_MAX_INPUT_TOKENS=8000

# Worker orchestration
REPORT_WORKER_POLL_MS=3000
REPORT_WORKER_MAX_POLL_MS=30000
REPORT_WORKER_IDLE_LOG_EVERY_MS=30000
REPORT_WORKER_LEASE_SECONDS=45
REPORT_WORKER_HEARTBEAT_SECONDS=10
REPORT_WORKER_MAX_ACTIVE_GLOBAL=2
REPORT_WORKER_MAX_ACTIVE_PER_TEAM=1
REPORT_WORKER_MAX_ACTIVE_DETAILS_GLOBAL=6
REPORT_WORKER_MAX_ACTIVE_DETAILS_PER_TEAM=3
REPORT_WORKER_MAX_JOB_RUNTIME_MS=900000
REPORT_WORKER_WATCHDOG_INTERVAL_MS=5000
WORKER_READY_STALE_AFTER_MS=45000

# Artifact server
REPORT_ARTIFACTS_DIR=/app/artifacts
WORKER_HTTP_PORT=9100

# Timeouts and cost controls
REPORT_AI_COST_CAP_USD=1
REPORT_GOOGLE_METRICS_TIMEOUT_MS=60000
REPORT_GOOGLE_PROFILE_TIMEOUT_MS=60000
REPORT_GSC_QUERY_PAGE_PAIRS_TIMEOUT_MS=60000
REPORT_CRAWL_TIMEOUT_MS=180000
REPORT_OPENAI_START_TIMEOUT_MS=120000
REPORT_OPENAI_POLL_INTERVAL_MS=3000
REPORT_OPENAI_POLL_TIMEOUT_MS=360000
REPORT_OPENAI_POLL_PHASE_TIMEOUT_MS=375000
REPORT_OPENAI_PARSE_FALLBACK_TIMEOUT_MS=120000

# Scheduler
WEEKLY_REVIEW_SCHEDULER_INTERVAL_MS=3600000
WEEKLY_REVIEW_TIMEZONE=Europe/Berlin

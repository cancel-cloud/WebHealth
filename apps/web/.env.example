# apps/web runtime env

# Shared runtime/db
DATABASE_URL=postgresql://<runtime-user>:<password>@db.webhealth.devbrew.dev:6432/webhealth?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT=20
DATABASE_POOL_CONNECT_TIMEOUT=10

# Shared secrets copied exactly between apps that read/write the same data.
# Generate OAUTH_TOKEN_ENCRYPTION_KEY with one of:
#   openssl rand -hex 32
#   openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# Public app origin and auth
NEXT_PUBLIC_APP_URL=https://webaudit-25.localcan.dev
BETTER_AUTH_URL=https://webaudit-25.localcan.dev
NEXT_PUBLIC_BETTER_AUTH_URL=https://webaudit-25.localcan.dev
# Server-only auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
STRIPE_STARTER_PRICE_ID=price_replace-with-starter-price-id
STRIPE_STUDIO_PRICE_ID=price_replace-with-studio-price-id
STRIPE_AGENCY_PRICE_ID=

# Browser/server monitoring
SENTRY_DSN=https://public@example-glitchtip.dev/1
NEXT_PUBLIC_SENTRY_DSN=https://public@example-glitchtip.dev/1
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional product analytics.
# POSTHOG_CAPTURE_HOST is the event endpoint/proxy.
# POSTHOG_UI_HOST and POSTHOG_PROJECT_ID are used for admin UI links and install checks.
# POSTHOG_PROJECT_TOKEN is used by server-side event capture.
# NEXT_PUBLIC_POSTHOG_KEY is browser-exposed and is usually the same phc_ token.
# Find the phc_ token in PostHog Project settings or the JavaScript install snippet.
# Legacy aliases accepted by shared code: POSTHOG_API_KEY, POSTHOG_HOST.
POSTHOG_CAPTURE_HOST=https://d.devbrew.dev
POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=replace-with-posthog-project-id
POSTHOG_PROJECT_TOKEN=phc_replace_with_project_token
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_client_key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

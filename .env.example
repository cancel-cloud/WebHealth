# ==========================================
# WebHealth Monorepo environment template
# ==========================================
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.neon.tech/<db>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<project>.<region>.neon.tech/<db>?sslmode=require

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-secret

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-state-secret
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT=20
DATABASE_POOL_CONNECT_TIMEOUT=10

REPORT_WORKER_POLL_MS=3000
REPORT_WORKER_IDLE_LOG_EVERY_MS=30000
REPORT_WORKER_LEASE_SECONDS=45
REPORT_WORKER_HEARTBEAT_SECONDS=10
REPORT_WORKER_MAX_ACTIVE_GLOBAL=2
REPORT_WORKER_MAX_ACTIVE_PER_TEAM=1
REPORT_WORKER_MAX_ACTIVE_DETAILS_GLOBAL=6
REPORT_WORKER_MAX_ACTIVE_DETAILS_PER_TEAM=3
REPORT_ARTIFACTS_DIR=/app/artifacts
REPORT_AI_COST_CAP_USD=1
REPORT_OPENAI_POLL_INTERVAL_MS=3000
REPORT_OPENAI_POLL_TIMEOUT_MS=360000

WORKER_HTTP_PORT=9100
WORKER_ARTIFACT_URL=http://localhost:9100
ARTIFACT_TOKEN_SECRET=replace-with-long-random-secret
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

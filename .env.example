# WebHealth combined runtime env example
# Use this file when you want one shared root env for both apps.
# App-specific variants also exist at:
# - apps/web/.env.example
# - apps/worker/.env.example

# ══ SHARED RUNTIME (web + worker) ════════════════════════════════════════════
DATABASE_URL=postgresql://<runtime-user>:<password>@db.webhealth.devbrew.dev:6432/webhealth?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT=20
DATABASE_POOL_CONNECT_TIMEOUT=10

# Used for OAuth refresh token encryption.
# Copy shared secrets exactly between apps that read/write the same data.
# Generate OAUTH_TOKEN_ENCRYPTION_KEY with one of:
#   openssl rand -hex 32
#   openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# Shared Google credentials used by auth and by source refresh jobs.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Shared auth/app origin. In local dev this should be your localcan HTTPS origin.
BETTER_AUTH_URL=https://webaudit-25.localcan.dev

# Optional telemetry
SENTRY_DSN=https://public@example-glitchtip.dev/1
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# ══ FRONTEND / apps/web ══════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=https://webaudit-25.localcan.dev
NEXT_PUBLIC_BETTER_AUTH_URL=https://webaudit-25.localcan.dev
# Server-only auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_SENTRY_DSN=https://public@example-glitchtip.dev/1

STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
STRIPE_STARTER_PRICE_ID=price_replace-with-starter-price-id
STRIPE_STUDIO_PRICE_ID=price_replace-with-studio-price-id

# Optional product analytics.
# POSTHOG_CAPTURE_HOST is the event endpoint/proxy.
# POSTHOG_UI_HOST and POSTHOG_PROJECT_ID are used for admin UI links and install checks.
# POSTHOG_PROJECT_TOKEN is used by server-side and worker event capture.
# NEXT_PUBLIC_POSTHOG_KEY is browser-exposed and is usually the same phc_ token.
# Find the phc_ token in PostHog Project settings or the JavaScript install snippet.
# Legacy aliases accepted by shared code: POSTHOG_API_KEY, POSTHOG_HOST.
POSTHOG_CAPTURE_HOST=https://d.devbrew.dev
POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=replace-with-posthog-project-id
POSTHOG_PROJECT_TOKEN=phc_replace_with_project_token
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_client_key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ══ WORKER / apps/worker ═════════════════════════════════════════════════════
DIRECT_DATABASE_URL=postgresql://<direct-user>:<password>@<private-host-or-predefined-network-name>:5432/webhealth?sslmode=require
# Optional explicit env file for packaged or one-off worker runs. When unset,
# worker-local env files are loaded before root env files.
WORKER_ENV_FILE=

# OPENAI_API_KEY is required for AI analysis. Model and token limits are now
# controlled by AI runtime settings in the database; keep the env values only
# for older deploy surfaces that still read them.
OPENAI_API_KEY=replace-with-openai-api-key
# Worker-only OpenAI admin key for importing organization Costs API totals.
# Keep this out of browser-exposed web env files.
OPENAI_ADMIN_KEY=replace-with-openai-admin-key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG=org_replace_with_org_id
OPENAI_PROJECT=proj_replace_with_project_id
OPENAI_MAX_TOKENS=1200
OPENAI_MAX_INPUT_TOKENS=8000
OPENAI_COST_RECONCILIATION_DAYS=90
OPENAI_COST_RECONCILIATION_INTERVAL_MS=86400000

WORKER_MAX_JOB_RUNTIME_MS=900000
WORKER_WATCHDOG_INTERVAL_MS=5000
WORKER_READY_STALE_AFTER_MS=45000
PROPERTY_REFRESH_WORKER_POLL_MS=4000
PROPERTY_REFRESH_WORKER_MAX_POLL_MS=30000
PROPERTY_REFRESH_WORKER_LEASE_SECONDS=45
AUTOMATED_PROPERTY_REFRESH_WORKER_POLL_MS=6000
AUTOMATED_PROPERTY_REFRESH_WORKER_MAX_POLL_MS=45000
METRICS_BACKFILL_WORKER_POLL_MS=4000
METRICS_BACKFILL_WORKER_MAX_POLL_MS=30000
METRICS_BACKFILL_WORKER_LEASE_SECONDS=90
ACTIVE_PROPERTY_AUTOMATION_INTERVAL_MS=3600000
ACTIVE_PROPERTY_AUTOMATION_TIMEZONE=Europe/Berlin
ACTIVE_PROPERTY_AUTOMATION_START_HOUR=6
# Optional override when the bundled dist cannot auto-locate the migrations folder.
WORKER_DB_MIGRATIONS_DIR=

WEEKLY_REVIEW_SCHEDULER_INTERVAL_MS=3600000
WEEKLY_REVIEW_TIMEZONE=Europe/Berlin
